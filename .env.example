# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Required. Bearer token for the web UI and API. Generate one with:
#   openssl rand -hex 32
CLOCKWORK_ADMIN_TOKEN=

# Postgres password used by docker compose.
POSTGRES_PASSWORD=change-me

# Shell tasks run arbitrary commands as the Clockwork user. Off by default.
CLOCKWORK_ENABLE_SHELL=false

# Host port for the UI/API (bound to 127.0.0.1).
CLOCKWORK_PORT=8080

# How many executions may run at once.
CLOCKWORK_WORKERS=4

# On shutdown, how long running executions may continue before they are interrupted (and retried).
CLOCKWORK_SHUTDOWN_TIMEOUT=30s

# How late a scheduled run may start and still count as on time.
CLOCKWORK_MISFIRE_GRACE=1m

# Outbound HTTP (tasks and webhooks). Applications' tasks may only reach public addresses
# unless CLOCKWORK_APP_HTTP_ALLOW_PRIVATE=true. CLOCKWORK_HTTP_DENY_PRIVATE=true applies
# that rule to every task, including the operator's.
CLOCKWORK_HTTP_DENY_PRIVATE=false
CLOCKWORK_APP_HTTP_ALLOW_PRIVATE=false

# json | text, and debug | info | warn | error
CLOCKWORK_LOG_FORMAT=json
CLOCKWORK_LOG_LEVEL=info

# When running the binary directly (not via compose):
# CLOCKWORK_DATABASE_URL=postgres://clockwork:change-me@localhost:5432/clockwork?sslmode=disable
# CLOCKWORK_HTTP_ADDR=:8080
# CLOCKWORK_WEB_DIR=./web/dist
# CLOCKWORK_SCHEDULER_INTERVAL=1s
